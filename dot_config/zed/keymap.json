[
  // Navigation
  {
    "context": "vim_mode != insert",
    "bindings": {
      // Panel Navigation
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "cmd-h": "workspace::ActivatePaneLeft",
      "cmd-l": "workspace::ActivatePaneRight",
      "cmd-j": "workspace::ActivatePaneDown",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-g": "workspace::ToggleBottomDock",

      // Tab Navigation
      "ctrl-shift-h": "pane::ActivatePreviousItem",
      "ctrl-shift-l": "pane::ActivateNextItem",
      "cmd-shift-h": "pane::ActivatePreviousItem",
      "cmd-shift-l": "pane::ActivateNextItem",

      // Misc
      "ctrl-g": "workspace::ToggleBottomDock",
      "ctrl-r": "task::Spawn",
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl-n": "workspace::NewFile",

      "cmd-r": "task::Spawn",
      "cmd-w": "pane::CloseActiveItem",
      "cmd-n": "workspace::NewFile",
    },
  },

  // Toggles
  {
    "context": "ProjectPanel || (Editor && vim_mode == normal)",
    "bindings": {
      "space e": "project_panel::Toggle",
    },
  },
  {
    "context": "(GitPanel && !Editor) || (GitPanel && Editor && vim_mode == normal) || (Editor && vim_mode == normal)",
    "bindings": {
      "space l": "git_panel::Toggle",
    },
  },
  // Popups
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space a": "outline::Toggle",
      "space b": "git::Branch",
      "space s": "git::ViewStash",
    },
  },

  // Panel detail
  {
    "context": "(GitPanel && !Editor) || (GitPanel && Editor && vim_mode == normal)",
    "bindings": {
      "o": "git::CreatePullRequest",
      // "s": "git::ToggleStaged",
      "c": "git::Commit",
      "b": "git::Branch",
      "s": "git::ViewStash",
      "p": "git::Pull",
    },
  },

  {
    "context": "GitStash",
    "bindings": {
      "d": "git::DropCurrentStash",
    },
  },

  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "enter": [
        "action::Sequence",
        ["project_panel::Open", "project_panel::Toggle"],
      ],
      "a": "project_panel::NewFile",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "x": "project_panel::Cut",
      "cmd-d": ["workspace::SendKeystrokes", "j j j j j j j j"], // Scroll down 8 times
      "cmd-u": ["workspace::SendKeystrokes", "k k k k k k k k "], // Scroll up 8 times
      "ctrl-d": ["workspace::SendKeystrokes", "j j j j j j j j"], // Scroll down 8 times
      "ctrl-u": ["workspace::SendKeystrokes", "k k k k k k k k "], // Scroll up 8 times
    },
  },

  // Global vim config
  {
    "context": "EmptyPane || Editor && vim_mode == normal",
    "bindings": {
      "space ;": "projects::OpenRecent",
      "space f": "file_finder::Toggle",

      "cmd-o": "pane::GoBack",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "r n": "editor::Rename",
      "space d k": "editor::GoToPreviousDiagnostic",
      "space d j": "editor::GoToDiagnostic",
      "space /": "workspace::NewSearch",
      "space d d": "diagnostics::Deploy",

      "alt-enter": "editor::OpenExcerpts",
      "cmd-d": ["workspace::SendKeystrokes", "j j j j j j j j"], // Scroll down 8 times
      "cmd-u": ["workspace::SendKeystrokes", "k k k k k k k k "], // Scroll up 8 times
      "space l": ["task::Spawn", { "task_name": "lazygit" }],
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-n": "workspace::NewTerminal",
      "ctrl-f": "workspace::ToggleZoom",
      "cmd-n": "workspace::NewTerminal",
      "cmd-f": "workspace::ToggleZoom",
    },
  },
]
